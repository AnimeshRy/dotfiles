[user]
	name = AnimeshRy
	email = animesh.gautam@1mg.com
[email]
	name = animesh.gautam@1mg.com
[color]
	ui = auto
[alias]
	logb = log --all --graph --decorate;
	gc = checkout;
	gcm = checkout master;
	gpull = pull;
	gf = fetch;
	gfa = fetch --all;
	gf = fetch origin;
	gpush = push;
	gpushf = push -f;
	gd = diff;
	ga = add .;
	glog = git log;
	gb = branch;
	gbr = branch remote;
	gfr = remote update;
	gbn = checkout -B;
	grf = reflog;
	grh = reset HEAD~; # last commit hard
	gac = add . && commit -a -m;
	gsu = gpush --set-upstream origin;
	glog = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --branches;
[init]
	defaultBranch = main
[core]
	editor = nvim

# Personal GitHub identity when any remote points at github.com (HTTPS or SSH).
# HTTPS: literal prefix is fine. SSH: use :*/** not :** (see git help config / SO 74012449).
# Bitbucket and other hosts keep the global [user] above (work).
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/dotfiles/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/dotfiles/.gitconfig-personal
[http]
	sslCAInfo = /Users/animeshgautam/certs/combined-ca.pem
